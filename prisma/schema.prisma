generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PersonType {
  PF
  PJ
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  name       String
  personType PersonType
  document   String     @unique
  properties Property[]
  tenants    Tenant[]
  contracts  Contract[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Property {
  id                  String   @id @default(cuid())
  ownerId             String
  owner               User     @relation(fields: [ownerId], references: [id])
  contracts           Contract[]
  label               String
  addressStreet       String
  addressNumber       String
  addressComplement   String?
  addressNeighborhood String
  addressCity         String
  addressState        String   @db.VarChar(2)
  addressZip          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([ownerId])
}

model Tenant {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  contracts Contract[]
  name      String
  document  String?
  email     String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

enum AdjustmentIndex {
  IGPM
  IPCA
  INPC
}

enum ContractStatus {
  ACTIVE
  ENDED
}

enum PaymentStatus {
  UPCOMING
  PAID
  LATE
}

model Contract {
  id              String           @id @default(cuid())
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id])
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id])
  rentValue       Decimal          @db.Decimal(10, 2)
  adjustmentIndex AdjustmentIndex
  baseDate        DateTime         @db.Date
  startDate       DateTime         @db.Date
  endDate         DateTime?        @db.Date
  status          ContractStatus   @default(ACTIVE)
  adjustments     RentAdjustment[]
  payments        Payment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([propertyId])
  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
}

model RentAdjustment {
  id               String          @id @default(cuid())
  contractId       String
  contract         Contract        @relation(fields: [contractId], references: [id])
  indexUsed        AdjustmentIndex
  indexRatePercent Decimal         @db.Decimal(7, 4)
  previousValue    Decimal         @db.Decimal(10, 2)
  newValue         Decimal         @db.Decimal(10, 2)
  referenceDate    DateTime        @db.Date
  appliedAt        DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([contractId])
}

model Payment {
  id         String        @id @default(cuid())
  contractId String
  contract   Contract      @relation(fields: [contractId], references: [id])
  dueDate    DateTime      @db.Date
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(UPCOMING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([contractId, dueDate])
  @@index([status, dueDate])
}