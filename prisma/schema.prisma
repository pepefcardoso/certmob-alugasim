generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PersonType {
  PF
  PJ
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailVerified   Boolean          @default(false)
  name            String
  personType      PersonType
  document        String           @unique
  image           String?
  properties      Property[]
  tenants         Tenant[]
  contracts       Contract[]
  privacyRequests PrivacyRequest[]
  sessions        Session[]
  accounts        Account[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Property {
  id                  String     @id @default(cuid())
  ownerId             String
  owner               User       @relation(fields: [ownerId], references: [id])
  contracts           Contract[]
  label               String
  addressStreet       String
  addressNumber       String
  addressComplement   String?
  addressNeighborhood String
  addressCity         String
  addressState        String     @db.VarChar(2)
  addressZip          String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([ownerId])
}

model Tenant {
  id        String     @id @default(cuid())
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id])
  contracts Contract[]
  name      String
  document  String?
  email     String
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([ownerId])
}

enum AdjustmentIndex {
  IGPM
  IPCA
  INPC
}

enum ContractStatus {
  ACTIVE
  ENDED
}

enum PaymentStatus {
  UPCOMING
  PAID
  LATE
}

model Contract {
  id              String           @id @default(cuid())
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id])
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id])
  rentValue       Decimal          @db.Decimal(10, 2)
  adjustmentIndex AdjustmentIndex
  baseDate        DateTime         @db.Date
  startDate       DateTime         @db.Date
  endDate         DateTime?        @db.Date
  status          ContractStatus   @default(ACTIVE)
  adjustments     RentAdjustment[]
  payments        Payment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([propertyId])
  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
}

model RentAdjustment {
  id               String          @id @default(cuid())
  contractId       String
  contract         Contract        @relation(fields: [contractId], references: [id])
  indexUsed        AdjustmentIndex
  indexRatePercent Decimal         @db.Decimal(7, 4)
  previousValue    Decimal         @db.Decimal(10, 2)
  newValue         Decimal         @db.Decimal(10, 2)
  referenceDate    DateTime        @db.Date
  appliedAt        DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([contractId])
}

model IndexRateCache {
  id                 String          @id @default(cuid())
  index              AdjustmentIndex
  referenceDate      DateTime        @db.Date
  accumulatedPercent Decimal         @db.Decimal(7, 4)
  fetchedAt          DateTime        @default(now())

  @@unique([index, referenceDate])
}

model Payment {
  id             String        @id @default(cuid())
  contractId     String
  contract       Contract      @relation(fields: [contractId], references: [id])
  dueDate        DateTime      @db.Date
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(UPCOMING)
  paidAt         DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([contractId, dueDate])
  @@index([status, dueDate])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  DELETION
  PORTABILITY
}

enum PrivacyRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model PrivacyRequest {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  type      PrivacyRequestType
  details   String?
  status    PrivacyRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

model Lead {
  id            String   @id @default(cuid())
  email         String
  whatsapp      String
  propertyCount Int
  source        String   @default("landing_hero")
  createdAt     DateTime @default(now())

  @@index([email])
}
